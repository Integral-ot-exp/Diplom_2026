@-webkit-keyframes tooltipAppearance {=20
  0% { transform: translate(-50%, 0px); opacity: 0; }
  8% { transform: translate(-50%, -10px); opacity: 1; }
  92% { transform: translate(-50%, -10px); opacity: 1; }
  100% { transform: translate(-50%, 0px); opacity: 0; }
}

@keyframes tooltipAppearance {=20
  0% { transform: translate(-50%, 0px); opacity: 0; }
  8% { transform: translate(-50%, -10px); opacity: 1; }
  92% { transform: translate(-50%, -10px); opacity: 1; }
  100% { transform: translate(-50%, 0px); opacity: 0; }
}

@-webkit-keyframes overlayAppearance {=20
  0% { opacity: 0; }
  100% { opacity: 1; }
}

@keyframes overlayAppearance {=20
  0% { opacity: 0; }
  100% { opacity: 1; }
}

@-webkit-keyframes popupAppearance {=20
  0% { transform: translateY(100%); }
  100% { transform: translateY(0px); }
}

@keyframes popupAppearance {=20
  0% { transform: translateY(100%); }
  100% { transform: translateY(0px); }
}

